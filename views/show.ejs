<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Task Details</title>
  </head>
  <body class="bg-gradient-to-br from-gray-900 to-gray-100 text-white min-h-screen">
    <div class="max-w-2xl mx-auto py-10 px-6">
      
      <!-- Back Link -->
      <a
        href="/"
        class="text-blue-400 hover:underline hover:text-blue-600 inline-block mb-8 transition"
      >
        ← Back to Home
      </a>

      <!-- Task Card -->
      <div class="bg-zinc-800 p-6 rounded-2xl shadow-lg space-y-6">
        <div>
          <h1 class="text-3xl font-bold mb-2 break-all text-blue-300"><%= file %></h1>
          <p class="text-lg text-gray-300 whitespace-pre-line"><%= data %></p>
        </div>

        <!-- Delete Form -->
        <form action="/delete-task/<%= file %>" method="POST" class="space-y-4">
          <input type="hidden" name="file" value="<%= file %>" />
          <button
            type="submit"
            class="w-full bg-red-600 hover:bg-red-700 text-white py-2 rounded-lg text-lg font-semibold transition"
          >
            🗑️ Delete Task
          </button>
        </form>

        <!-- Update Form -->
        <form action="/update-task/<%= file %>" method="POST" class="space-y-4">
          <textarea
            name="updatedData"
            rows="5"
            class="w-full p-3 rounded-lg bg-gray-100 text-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-400"
            placeholder="Update your task details..."
          ><%= data %></textarea>

          <button
            type="submit"
            class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2 rounded-lg text-lg font-semibold transition"
          >
            ✏️ Update Task
          </button>
        </form>
      </div>
    </div>
  </body>
</html>
