<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
    <title>All Tasks</title>
  </head>
  <body class="bg-gradient-to-br from-gray-900 to-gray-100 text-white min-h-screen">
    <div class="max-w-3xl mx-auto py-10 px-6">
      
      <!-- Back to Home -->
      <a
        href="/"
        class="text-blue-400 hover:underline hover:text-blue-600 inline-block mb-8 transition"
      >
        ← Back to Home
      </a>

      <!-- Task List Section -->
      <div class="bg-white text-gray-900 p-6 rounded-2xl shadow-xl">
        <h1 class="text-3xl font-bold text-center text-blue-700 mb-6">📚 All Tasks</h1>

        <% if(files.length > 0) { %>
          <ul class="space-y-4">
            <% files.forEach(function(file) { %>
              <li class="border-b pb-3 hover:bg-gray-100 px-2 py-1 rounded-lg transition">
                <h3 class="text-lg font-semibold break-words"><%= file %></h3>
                <a
                  href="/file/<%= file %>"
                  class="text-sm text-blue-600 hover:underline"
                >
                  🔍 Read Task
                </a>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="text-center text-gray-600">No tasks found.</p>
        <% } %>
      </div>
    </div>
  </body>
</html>
